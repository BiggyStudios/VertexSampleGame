# Simple house: box walls with a pyramid roof. Hand-written to test model loading.
mtllib house.mtl

v -1.0 0.0 -1.0
v  1.0 0.0 -1.0
v  1.0 0.0  1.0
v -1.0 0.0  1.0
v -1.0 1.2 -1.0
v  1.0 1.2 -1.0
v  1.0 1.2  1.0
v -1.0 1.2  1.0
v -1.2 1.2 -1.2
v  1.2 1.2 -1.2
v  1.2 1.2  1.2
v -1.2 1.2  1.2
v  0.0 2.2  0.0

vn  1.0 0.0 0.0
vn -1.0 0.0 0.0
vn  0.0 0.0 1.0
vn  0.0 0.0 -1.0
vn  0.0 -1.0 0.0
vn  0.0 0.768 0.640
vn  0.0 0.768 -0.640
vn  0.640 0.768 0.0
vn -0.640 0.768 0.0

o Walls
usemtl Walls
f 4//3 3//3 7//3 8//3
f 2//4 1//4 5//4 6//4
f 3//1 2//1 6//1 7//1
f 1//2 4//2 8//2 5//2
f 1//5 2//5 3//5 4//5

o Roof
usemtl Roof
f 12//6 11//6 13//6
f 10//7 9//7 13//7
f 11//8 10//8 13//8
f 9//9 12//9 13//9
f 9//5 10//5 11//5 12//5
